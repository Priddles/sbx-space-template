// For format details, see https://aka.ms/devcontainer.json.
{
  // TEMPLATE: Update devcontainer name
  "name": "devcontainer",

  "build": {
    "dockerfile": "../.sbx/kit-sbx-base/kit-sbx-base.dockerfile",
    "target": "devcontainer",
    "args": { "USERNAME": "code" }
  },

  "features": {
    // The image already has the Docker engine; this starts the daemon like the sandbox does.
    // Moby is not packaged for trixie.
    "ghcr.io/devcontainers/features/docker-in-docker:4": { "moby": false }
  },

  // Same path as on the host and in the sandbox, since git worktrees link to their repo by
  // absolute path.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
  "workspaceFolder": "${localWorkspaceFolder}",

  "waitFor": "postStartCommand",

  "remoteUser": "code"
}
